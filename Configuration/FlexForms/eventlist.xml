<?xml version="1.0" encoding="utf-8"?>
<T3DataStructure>
    <sheets>
        <general>
            <ROOT>
                <TCEforms>
                    <sheetTitle>LLL:EXT:rescue_reports/Resources/Private/Language/locallang_db.xlf:sheet.general</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>

                    <templateVariant>
                        <TCEforms>
                            <label>LLL:EXT:rescue_reports/Resources/Private/Language/locallang_db.xlf:templateVariant</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <items>
                                    <numIndex index="0">
                                        <numIndex index="0">Standard</numIndex>
                                        <numIndex index="1">standard</numIndex>
                                    </numIndex>
                                    <numIndex index="1">
                                        <numIndex index="0">Sidebar</numIndex>
                                        <numIndex index="1">sidebar</numIndex>
                                    </numIndex>
                                    <numIndex index="2">
                                        <numIndex index="0">NewDesign</numIndex>
                                        <numIndex index="1">newdesign</numIndex>
                                    </numIndex>
                                    <numIndex index="3">
                                        <numIndex index="0">NewDesignSidebar</numIndex>
                                        <numIndex index="1">newdesignsidebar</numIndex>
                                    </numIndex>
                                </items>
                                <default>standard</default>
                            </config>
                        </TCEforms>
                    </templateVariant>

                    <settings.defaultStation>
                        <TCEforms>
                            <label>Standard-Ortsfeuerwehr</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <itemsProcFunc>In2code\RescueReports\UserFunctions\FlexFormStationItems->addPrimaryStations</itemsProcFunc>
                                <items>
                                    <numIndex index="0">
                                        <numIndex index="0">-- keine Auswahl --</numIndex>
                                        <numIndex index="1">0</numIndex>
                                    </numIndex>
                                </items>
                                <minitems>0</minitems>
                                <maxitems>1</maxitems>
                                <size>1</size>
                            </config>
                        </TCEforms>
                    </settings.defaultStation>

                    <maxCount>
                        <TCEforms>
                            <label>LLL:EXT:rescue_reports/Resources/Private/Language/locallang_db.xlf:maxCount</label>
                            <config>
                                <type>input</type>
                                <eval>int</eval>
                                <size>5</size>
                                <default>0</default>
                            </config>
                        </TCEforms>
                    </maxCount>

                    <dateFrom>
                        <TCEforms>
                            <label>LLL:EXT:rescue_reports/Resources/Private/Language/locallang_db.xlf:dateFrom</label>
                            <config>
                                <type>input</type>
                                <renderType>inputDateTime</renderType>
                                <eval>date</eval>
                            </config>
                        </TCEforms>
                    </dateFrom>

                    <dateTo>
                        <TCEforms>
                            <label>LLL:EXT:rescue_reports/Resources/Private/Language/locallang_db.xlf:dateTo</label>
                            <config>
                                <type>input</type>
                                <renderType>inputDateTime</renderType>
                                <eval>date</eval>
                            </config>
                        </TCEforms>
                    </dateTo>

                    <enableSearch>
                        <TCEforms>
                            <label>LLL:EXT:rescue_reports/Resources/Private/Language/locallang_db.xlf:enableSearch</label>
                            <config>
                                <type>check</type>
                                <items>
                                    <numIndex index="0">
                                        <numIndex index="0">Ja</numIndex>
                                    </numIndex>
                                </items>
                            </config>
                        </TCEforms>
                    </enableSearch>

                    <detailPageUid>
                        <TCEforms>
                            <label>LLL:EXT:rescue_reports/Resources/Private/Language/locallang_db.xlf:detailPageUid</label>
                            <config>
                                <type>group</type>
                                <internal_type>db</internal_type>
                                <allowed>pages</allowed>
                                <size>1</size>
                                <minitems>1</minitems>
                                <maxitems>1</maxitems>
                            </config>
                        </TCEforms>
                    </detailPageUid>

                </el>
            </ROOT>
        </general>
    </sheets>
</T3DataStructure>